# Copy this file to .env and replace every CHANGE_ME value.
NODE_ENV=development
PORT=3000

# Local Docker PostgreSQL settings
POSTGRES_DB=buraq_holidays
POSTGRES_USER=buraq
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgres://buraq:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/buraq_holidays
# Uncomment for Neon or another external PostgreSQL provider requiring TLS:
# PGSSLMODE=require

# Database field encryption key: generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS

# Session signing secret: generate with: openssl rand -hex 48
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_48_RANDOM_CHARACTERS

# Initial Super Admin is created only when the database has no Super Admin.
ADMIN_USERNAME=admin
ADMIN_NAME=Buraq Super Admin
ADMIN_PASSWORD=CHANGE_ME_USE_AT_LEAST_14_CHARACTERS
